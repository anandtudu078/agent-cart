# Server
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Frontend-facing API base
API_BASE_URL=http://localhost:4000

# MongoDB (Mongoose) — local Docker container used in development:
MONGODB_URI=mongodb://127.0.0.1:27017/agentcart
# …or MongoDB Atlas (free M0). Required in production (NODE_ENV=production):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/agentcart?retryWrites=true&w=majority

# PayPal Checkout Server SDK
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI agent (Python/LangChain service)
AGENT_SERVICE_URL=http://localhost:8000
# Built-in Node scan loop: seconds between price-check cycles (min 5)
AGENT_INTERVAL_SEC=30
# Nano (XNO) settle leg — the seller's receive address; empty disables the
# leg (nano-quote / nano-verify answer 501), exactly like unset PayPal creds
NANO_ADDRESS=
# Ledger read endpoint — a public node, no key needed
NANO_RPC_URL=https://nanorpc.cc
# Rate fallback when the CoinGecko price feed is unreachable
XNO_USD_RATE=

# Auth (required in production)
JWT_SECRET=
